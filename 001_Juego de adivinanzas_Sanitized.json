    {
      "parameters": {
        "jsCode": "const currentClues = $(\"Get row(s) in sheet\").all()[0].json.pistas\n  ? JSON.parse($(\"Get row(s) in sheet\").all()[0].json.pistas)\n  : [];\nconst newClue = $input.all()[0].json.pista_nueva; // the new clue returned by the AI\ncurrentClues.push(newClue);\nconst newAttempts = $(\"Get row(s) in sheet\").all()[0].json.intentos + 1;\n\nreturn [\n  {\n    json: {\n      pistas_actualizado: JSON.stringify(currentClues),\n      intentos_actualizado: newAttempts,\n      ultima_pista_actualizado: newClue,\n    },\n  },\n];\n"
