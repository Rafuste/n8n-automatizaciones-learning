    {
      "parameters": {
        "jsCode": "// Obtener la respuesta del AI Agent (debería ser un JSON string)\nconst respuestaRaw = $input.first().json.output; // o .output, depende de la versión. A veces la respuesta está en $json.response. Revisa ejecutando una vez.\n// Para evitar errores, primero haz un console.log para ver qué llega.\n// Por seguridad, intentamos parsear.\nlet respuesta;\ntry {\n  respuesta = JSON.parse(respuestaRaw);\n} catch(e) {\n  // Si no es JSON, devolvemos error\n  return [{ json: { error: \"El agente no devolvió JSON válido\", raw: respuestaRaw } }];\n}\nreturn [{ json: respuesta }];"
